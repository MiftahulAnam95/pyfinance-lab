{
  "name": "pyfinance-lab",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "python3 -m unittest discover -s tests -v && tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "keywords": [],
  "author": "",
  "description": "Ruang praktikum Python dan persiapan UAS pencatat keuangan mahasiswa",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@iconify-json/solar": "^1.2.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "private": true
}
